# --- Private analytics dashboard (/stats) ---
# Passcode required to view visitor statistics. Use a long, random string.
# The /stats page and /api/stats endpoint reject all access until this is set.
STATS_PASSCODE=

# --- Durable analytics storage: Postgres via Prisma (recommended for Vercel) ---
# When DATABASE_URL is set, visits are stored in Postgres and NEVER deleted.
# The `visits` table is created automatically on first write.
#   - Local:  put your connection string in .env (this same variable name).
#   - Vercel: add DATABASE_URL under Project -> Settings -> Environment Variables.
#             If you use Vercel Postgres, set it to the POOLED connection string.
# Works with any Postgres: Vercel Postgres, Neon, Supabase, or a local DB.
DATABASE_URL="postgresql://root:password@localhost:5432/trackers"

# Optional: override where visit logs are written WHEN Postgres is not configured.
# Defaults to .data/visits.json locally, and /tmp/visits.json on Vercel (ephemeral).
# VISITS_FILE=
