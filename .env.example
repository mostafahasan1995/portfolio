# --- Private analytics dashboard (/stats) ---
# Passcode required to view visitor statistics. Use a long, random string.
# The /stats page and /api/stats endpoint reject all access until this is set.
STATS_PASSCODE=

# --- Durable analytics storage (recommended for Vercel) ---
# When POSTGRES_URL is set, visits are stored in Postgres and NEVER deleted.
# Vercel sets this automatically: Vercel Dashboard -> Storage -> Create Database
# -> Postgres, then "Connect" it to this project. Redeploy and it just works.
# For local development you can point it at any Postgres (Neon, Supabase, local).
POSTGRES_URL=

# Optional: override where visit logs are written WHEN Postgres is not configured.
# Defaults to .data/visits.json locally, and /tmp/visits.json on Vercel (ephemeral).
# VISITS_FILE=
