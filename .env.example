# --- Private analytics dashboard (/stats) ---
# Passcode required to view visitor statistics. Use a long, random string.
# The /stats page and /api/stats endpoint reject all access until this is set.
STATS_PASSCODE=

# Optional: override where visit logs are written.
# Defaults to .data/visits.json locally, and /tmp/visits.json on Vercel.
# NOTE: On Vercel the filesystem is ephemeral — logs there do NOT persist across
# deploys or cold starts. For durable analytics on Vercel, use a KV/DB instead.
# VISITS_FILE=
